            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦전문기관 및 10대 성과물 전담기관에서 개별적으로 관리·유통하는 연구개발 성과 정보를 연계·통합 ◦성과정보 공유와 인지도를 제고하여 우수 연구개발성과의 창출과 고도화 촉진",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 89.39999999999999,
              "t": 353.4,
              "r": 127.58980997433599,
              "b": 365.4,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 2,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 2,
            "text": "사업내용",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 285.5039999999999,
              "r": 522.14945477376,
              "b": 432.59999999999997,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦통합성과활용플랫폼 운영을 위한 클라우드 기반의 HW/SW 환경 구축 ◦2025년 구축 대상 10대 성과물의 기초데이터 구축 및 연계 - 2025년 구축대상 성과물의 표준화 및 연구개발 성과정보 전체 대상의 표준화 및 현행화 - 2024년 구축 성과정보의 유관정보(논문, 특허) 확장 구축 및 기존 DB 보완 - IRIS 과제정보 연계 및 유관정보(각 부처 우수성과) 구축 ◦검색서비스(통합검색, 유형별 검색 등) 개발 및 시범서비스 오픈 ◦과학기술 이슈분석 서비스 추진계획 구체화 및 개발계획 마련 ◦서비스 수요자 대상 자문단을 구성하여 수요 기반 서비스 기능개발 추진",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.32,
              "t": 519.6,
              "r": 98.669564083968,
              "b": 548.4,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 2,
            "col_span": 1,
            "start_row_offset_idx": 5,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "예상 성과",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
