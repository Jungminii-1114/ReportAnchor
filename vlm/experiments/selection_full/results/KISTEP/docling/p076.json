            "end_row_offset_idx": 6,
            "start_col_offset_idx": 3,
            "end_col_offset_idx": 4,
            "text": "대한 간접비고시비율 정부 간접비",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 355.56,
              "t": 681.0,
