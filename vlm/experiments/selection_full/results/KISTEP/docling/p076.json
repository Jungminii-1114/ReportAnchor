            "start_col_offset_idx": 2,
            "end_col_offset_idx": 3,
            "text": "수행 대학에 사항은 향후",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 297.47999999999996,
