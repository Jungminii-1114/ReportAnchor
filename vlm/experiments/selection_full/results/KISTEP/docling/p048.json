          },
          {
            "bbox": {
              "l": 148.92,
              "t": 235.70399999999995,
              "r": 522.3896458938241,
              "b": 507.59999999999997,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 1,
            "end_row_offset_idx": 2,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "◦국가연구개발사업 및 연구기관에 대한 성과평가를 통해 국가 R&D 추진의 효율성 및 R&D투자의 효과성 제고 ◦국가연구개발 성과 등록·기탁물에 대한 체계적이고 종합적인 분석을 통해 성과물 관리·활용 정보를 다양한 수요자에게 제공 ◦5년 단위의 연구성과 관리·활용 기본계획 및 매년 수립되는 실시계획의 성과관리· 활용·확산 관련 기초자료로 활용 ◦국가R&D 분석결과 등을 국가과학기술자문회의에 보고함으로써 관련 정책에 대한 구체적 논의 진행과 정책설계에 기여 ◦국가연구개발사업 조사·분석과 연구개발활동조사 주요결과를 OECD에 제출하여 국제 R&D 통계자료인 MSTI*, R&D Statistics 등에 활용 * Main Science and Technology Indicators ◦원시자료와 분석결과의 온라인 정보서비스(NTIS 등) 및 오프라인 보고서 등 다양한 형태로 제공하여 국가R&D 통계에 대한 활용도 제고",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 117.0,
              "t": 141.48000000000002,
              "r": 136.22959135391997,
              "b": 153.48000000000002,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 0,
            "end_row_offset_idx": 1,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "정성",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 75.98400000000004,
              "r": 522.5098642838402,
              "b": 218.27999999999997,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 0,
            "end_row_offset_idx": 1,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "◦사업평가 결과를 예산 배분･조정과 연계, 사업 구조 조정･개선을 유도, 경제적･사회적 영향을 분석하여 정책수립에 환류 ◦과학기술분야 출연연구기관의 기관운영 및 연구사업의 문제점 개선･보완, 기관 고유 임무 조정, 기관장･직원 인센티브 등과 연계 ◦성과물(화합물, 생물자원, 생명정보, 소프트웨어, 신품종 등) 자료 및 분석결과 제공 ◦OECD, 정보서비스(NTIS 등)에 공식 R&D 통계자료로 제공 ◦국가별 과학기술 혁신역량 진단, 과학기술 정책과 관련된 핵심 통계데이터와 결과 제공",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          }
        ],
