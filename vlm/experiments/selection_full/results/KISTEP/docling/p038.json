            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "◦과학기술혁신 Think Tank로서 과학기술 국제협력 네트워크 강화 및 글로벌 과학 기술혁신 역량 제고 ◦과학기술 국제기구 및 다자협력 강화를 통해 글로벌 과학기술 리더십 확보에 기여",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.32,
