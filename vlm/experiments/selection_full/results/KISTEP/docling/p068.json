            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "정성",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 501.984,
              "r": 457.34956408396795,
              "b": 581.88,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦중앙부처(과기정통부)의 지역과기혁신정책 총괄 기획･조정 지원 - 과학기술기반의 지역혁신 역량 제고 방안 등 전략 수립 지원 등 ◦연지단 수요를 기반으로 맞춤형 컨설팅 및 개선 방안 제시 - 연지단 사업 기획시, 사업 설계 및 추진 방향(전략 수립) 등 지원 ◦지역과학기술정보서비스(RTIS) 운영 및 고도화",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.92,
              "t": 615.84,
              "r": 137.070028594752,
              "b": 627.84,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
