            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦지역이 주도하는 근거기반의 과학기술혁신정책 수립을 위한 연구개발지원단 기능 강화와 중앙과 지역이 협력하는 통합적 과학기술혁신정책 수립 지원",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 89.39999999999999,
              "t": 327.0,
              "r": 127.58980997433599,
              "b": 339.0,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 2,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 2,
            "text": "사업내용",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 242.30399999999997,
              "r": 522.2696458938241,
              "b": 423.0,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦지역의 근거기반 맞춤형 과학기술혁신전략 수립 지원 - 지역별 과학기술혁신환경 및 역량에 대한 분석을 토대로 각 지역의 맞춤형 과기혁신 전략 수립을 위한 활용성이 높은 정책 근거 자료 제시 ◦지역과학기술혁신 데이터의 통합적 구축 및 공유 체계 마련 - 광역 시·도별 (매년)R&D과제, R&D성과, (격년)혁신기관 및 혁신클러스터 조사·분석 - 지역과학기술정보서비스(이하 RTIS) 구축 및 운영 고도화 - 상시적 수요조사를 통해 플랫폼 정보, 콘텐츠, 커뮤니티 공간 및 서비스 등을 지속 개선하여 정보공유･축적 및 정책 수립 지원 효과성 제고 ◦ 중앙(과기부)과 지역(연지단)의 Think-Tank로서 정책 고객 지원 강화 - 과기부 지역과학기술혁신정책 기획･조정시 요구되는 정책현안 근접 지원 - 지역기술혁신허브 운영 상세 기획, 허브 선정 및 컨설팅 등 적시 지원",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.32,
              "t": 500.76,
              "r": 98.669564083968,
              "b": 529.56,
              "coord_origin": "TOPLEFT"
            },
