            "end_row_offset_idx": 7,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "예상 성과",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
