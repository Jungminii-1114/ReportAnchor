            "start_row_offset_idx": 7,
            "end_row_offset_idx": 8,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 2,
            "text": "성과활용계획",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 606.7439999999999,
