            "start_col_offset_idx": 0,
            "end_col_offset_idx": 2,
            "text": "최종목표",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 188.06399999999996,
              "r": 522.149564083968,
