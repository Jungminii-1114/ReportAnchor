            "start_row_offset_idx": 2,
            "end_row_offset_idx": 3,
            "start_col_offset_idx": 3,
            "end_col_offset_idx": 4,
            "text": "'24년 751백만원 및 후속조치(보안지침･보안대책 보안지침 마련 후속조치에",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 359.03999999999996,
              "t": 123.72000000000003,
              "r": 455.3098099743359,
              "b": 238.31999999999994,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 2,
            "end_row_offset_idx": 3,
            "start_col_offset_idx": 4,
            "end_col_offset_idx": 5,
            "text": "'25년 마련) 실시 보안대책 공통양식 의견수렴(공청회",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 460.32,
              "t": 123.72000000000003,
              "r": 510.8697006641281,
              "b": 221.51999999999998,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 2,
            "end_row_offset_idx": 3,
            "start_col_offset_idx": 5,
            "end_col_offset_idx": 6,
            "text": "688백만원 제정",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 89.39999999999999,
              "t": 159.60000000000002,
