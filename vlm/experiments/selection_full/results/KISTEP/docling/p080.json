            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "성과활용계획",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 649.944,
              "r": 522.5097006641281,
              "b": 746.64,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 7,
            "end_row_offset_idx": 8,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦ 「국가연구개발혁신법」및 동법 시행령·시행규칙 등 연구보안 관련 제도개선 착안점 도출 및 근거기반으로 활용 ◦ 실태조사 및 국외수혜정보보고 등을 통한 우리나라 연구현장의 외국 영향성 이해도 제고를 통해 연구자산 유출 및 보호를 위한 제도개선 근거기반 확충 ◦ 연구보안 체계 고도화를 통한 국가연구자산 유출 예방 및 주요국 국제연구 협력의 기반 마련을 통한 협력 수월성 제고",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          }
