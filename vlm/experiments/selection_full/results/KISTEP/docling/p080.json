            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 5,
            "end_row_offset_idx": 6,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦ 연구보안 보안지침 및 중앙행정기관/연구기관 표준 보안대책 마련 : 1건 ◦ 보고서 : 1건",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 117.0,
              "t": 593.64,
              "r": 136.22959135391997,
              "b": 605.64,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "정성",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 567.7439999999999,
              "r": 522.2697554344322,
              "b": 630.84,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦ 연구현장 컨설팅 및 각종 홍보를 통한 연구현장의 연구보안 체질개선 및 국제공동 연구 저변 고도화 ◦ 보안관련 학과 개설 대학의 연구보안 인력양성 및 연구지원인력 재교육을 통한 연구 현장의 연구보안 연구개발지원인력 인력수급 기여",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.92,
              "t": 692.64,
              "r": 137.070028594752,
              "b": 704.64,
              "coord_origin": "TOPLEFT"
