              "b": 171.60000000000002,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 2,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 2,
            "text": "최종목표",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 150.50400000000002,
              "r": 522.3895913539201,
              "b": 180.0,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦ 글로벌 스탠다드에 부합하는 국가연구자산 보호를 위한 연구보안 체계 내실화 방안 이행 및 관련 제도·정책 수립·설계 지원",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 89.39999999999999,
              "t": 343.91999999999996,
              "r": 127.58980997433599,
              "b": 355.91999999999996,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 2,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 2,
            "text": "사업내용",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 259.22399999999993,
              "r": 483.74959135392,
              "b": 507.12,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦ 연구기관(학･연) 대상 현장·온라인 컨설팅 수행 및 제도개선사항 홍보 - 학·연 위주로 연구보안 현장컨설팅 시범실시 - 연구보안 현장지침 온라인 컨텐츠 및 카드뉴스 컨텐츠 개발 - 연구보안 자가진단 및 연구책임자의 보안 위험성 평가도구 개발 - 권역별 설명회 실시, 제도개선사항 및 연구현장 의견수렴 병행 ◦ 국외수혜정보 보고체계 고도화 및 연구보안 조사체계 수립 - 국외수혜정보보고 제도 설명･홍보(온･오프라인) - IRIS 국외수혜정보보고 편의 제고, 연구기관 단위 자체 관리체계 수립 - 연구보안에 관한 이해관계자 대상의 연구보안 실태조사 실시 ◦ 연구보안 전문인력 양성 및 양성체계 전문성 제고 - 대학과 전문기관이 인력양성과 재교육을 분담하는 체계 수립 ◦ 주요국 연구보안 체계와 지속적인 협력기반 유지·강화",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.32,
              "t": 561.0,
