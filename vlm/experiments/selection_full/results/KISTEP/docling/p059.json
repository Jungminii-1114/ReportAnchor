            "start_row_offset_idx": 2,
            "end_row_offset_idx": 3,
            "start_col_offset_idx": 4,
            "end_col_offset_idx": 5,
            "text": "'25년 지원하고,",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 423.71999999999997,
              "t": 175.68000000000006,
