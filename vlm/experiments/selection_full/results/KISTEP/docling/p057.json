            "col_span": 1,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 3,
            "text": "관한 R&D예산 증대를 위한 촉진을",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 306.59999999999997,
