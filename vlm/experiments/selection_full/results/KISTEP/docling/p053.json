              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 7,
            "end_row_offset_idx": 8,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 6,
            "text": "◦R&D사업 사전분석 관련 제도 변화에 대한 기민한 대응 ◦KISTEP의 국가연구개발사업 사전분석 전문기관으로서의 리더십 지속 ◦국가연구개발사업 사전분석을 위한 유관기관과의 업무연계 강화",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
