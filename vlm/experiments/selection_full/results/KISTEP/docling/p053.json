            "start_col_offset_idx": 1,
            "end_col_offset_idx": 2,
            "text": "정량",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 467.424,
