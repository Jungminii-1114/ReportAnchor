              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "최종목표",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 197.54399999999998,
              "r": 522.1496736245763,
              "b": 243.84000000000003,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦연구자 권익보호와 제재처분의 일관성 및 전문성 확보 ◦부처의 사전 제재처분에 대해 연구자 권익과 사회적 책임 간의 균형을 고려하여 합리적으로 심의하고, 관련 제도 개선을 통해 건전한 연구생태계 조성",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 89.39999999999999,
              "t": 379.8,
              "r": 127.58980997433599,
              "b": 391.8,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "사업내용",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 278.304,
              "r": 522.3897279340802,
              "b": 492.59999999999997,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦부처별 제재처분의 적절성을 재검토하기 위한 제재처분재검토회의 운영 - 제재처분의 적절성 재검토회의의 효율적인 진행을 위하여 회의의 제반 사항 및 주요 사항 사전검토, 상정 안건 작성, 심의 활동을 지원 ◦연구윤리 및 연구자 권익보호 정책연구, 제재처분 절차 및 제도 개선 연구 - 연구환경 변화에 대응하기 위한 권익보호 과제를 지속적으로 발굴하기 위한 국내외 사례연구 및 다양한 전문 분야의 시각이 반영된 정책 및 제도 제안 ◦국가연구개발혁신법 등 제도개선, 연구윤리 및 제재처분 실무 가이드라인 제시 - 연구현장 및 유관기관 대응 등을 통해 연구자 권익보호, 연구윤리 및 제재처분 제도 개선 사항을 발굴 - 법률전문가 및 실무전문가들과의 검토를 통해 법령 개정, 실무 가이드라인 등 체계 고도화",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.32,
              "t": 525.24,
              "r": 137.070028594752,
              "b": 700.1999999999999,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 5,
            "end_row_offset_idx": 6,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "예상 성과 정량 정성 성과활용계획",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 524.544,
              "r": 343.94945477375995,
              "b": 537.24,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 5,
            "end_row_offset_idx": 6,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦2025년 개정 제재처분 가이드라인 : 1건",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 570.024,
              "r": 497.78956408396795,
              "b": 616.3199999999999,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦국가연구개발사업에 참여하는 연구자들의 권익 보호 증진에 기여 ◦제재처분에 대한 공통된 기준 및 절차의 확산에 기여 ◦연구현장의 윤리의식 제고와 함께 연구자 권익 보호 관련 정책 수립에 기여",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 653.904,
              "r": 522.3895913539201,
              "b": 733.8,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 7,
            "end_row_offset_idx": 8,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦연구자권익보호위원회의 효율적이고 원활한 운영을 유도 ◦연구자 권익보호 및 제재처분 재검토 관련 제도 개선사항 도출을 통해 연구자권익 보호위원회 심의결과의 실효성 강화 ◦연구자권익보호회의 안건 상정, 실무 가이드라인 또는 법령 개정(안) 수요 등에 반영 하여 제도 개선의 선순환 체계 마련",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          }
        ],
