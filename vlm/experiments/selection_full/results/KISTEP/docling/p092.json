            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 3,
            "end_row_offset_idx": 4,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦ 군 소요의 필요성 및 사업추진계획의 적절성을 분석하여, 국방획득분야의 공정하고 투명한 예산편성 및 집행이 가능하도록 정부의 합리적 의사결정 지원",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 89.39999999999999,
              "t": 365.4,
              "r": 127.58980997433599,
              "b": 377.4,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "사업내용",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 272.304,
              "r": 410.66956408396794,
              "b": 469.79999999999995,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 4,
            "end_row_offset_idx": 5,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦ 사업개요 및 연구이슈 도출 - 사업 개요, 소요내용 및 현 실태, 주요 연구이슈 도출 ◦ 소요 분석 - 소요필요성 분석 - 작전운용성능(ROC)의 적정성 검토 - 소요량 및 전력화시기 검토 ◦ 사업추진계획 분석 - 사업추진준비도 분석, 사업 추진계획 검토 ◦ 경제성 분석 - 총사업비 검토, 경제성 검토 ◦ 종합 결론 - 종합결론, 정책적 제안",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.32,
              "t": 525.0,
              "r": 136.22959135391997,
              "b": 576.36,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 5,
            "end_row_offset_idx": 6,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "예상 성과 정량",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 524.304,
              "r": 351.6295640839679,
              "b": 537.0,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 5,
            "end_row_offset_idx": 6,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦ 국방획득 R&D사업타당성조사 : 5건 수행",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 79.92,
              "t": 582.6,
              "r": 137.070028594752,
              "b": 680.76,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 1,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "정성 성과활용계획",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 573.5039999999999,
              "r": 522.2697554344322,
              "b": 603.0,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 6,
            "end_row_offset_idx": 7,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦ 방위력개선 신규 R&D사업 착수 이전에 사업추진 관련사항을 투명하고 공정하게 점검함으로써 정부 예산 낭비방지 및 재정운영의 효율성 제고",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
              "t": 642.8639999999999,
              "r": 522.269509544064,
              "b": 705.9599999999999,
              "coord_origin": "TOPLEFT"
            },
            "row_span": 1,
            "col_span": 4,
            "start_row_offset_idx": 7,
            "end_row_offset_idx": 8,
            "start_col_offset_idx": 1,
            "end_col_offset_idx": 5,
            "text": "◦ 방위력개선사업 사업타당성조사 결과는 방사청, 기재부 등 국방 R&D/예산 관련 부처에 통보되어 예산편성 및 총사업비 관리 시 효과적으로 활용 ◦ 소요군(육･해･공) 및 합참에도 통보되어 제기된 군 신규무기체계 도입 소요의 필요성을 객관적으로 검증함으로써 사업 추진계획의 적절성 확보에 기여",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          }
