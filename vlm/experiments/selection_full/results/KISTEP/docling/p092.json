            "start_col_offset_idx": 0,
            "end_col_offset_idx": 1,
            "text": "최종목표",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 148.92,
